# Use an official Python runtime as a parent image
FROM python:3.10-slim

# Force python to not buffer logs (better for Cloud Logging)
ENV PYTHONUNBUFFERED=1

# Set the working directory in the container
WORKDIR /app

# Copy the requirements files first to leverage Docker cache
COPY requirements-core.txt /app/
COPY api/requirements.txt /app/api/

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt

# Copy the rest of the application code
COPY core /app/core
COPY api /app/api
COPY __init__.py /app/

# Make port 8080 available to the world outside this container
EXPOSE 8080

# Run app.py using shell execution to properly expand the PORT variable
#CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
# Alternative: Use direct exec form. Cloud Run handles the port injection.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
